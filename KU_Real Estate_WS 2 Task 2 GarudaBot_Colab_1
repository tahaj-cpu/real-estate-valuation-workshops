        "        # Deterministic path: a click already states the intent exactly, so\n",
        "        # it calls its handler directly rather than round-tripping through\n",
        "        # keyword matching that could mis-classify it.\n",
        "        def handle_topic_click(key: str, sample: str, history: list[dict]) -> list[dict]:\n",
        "            return history + [\n",

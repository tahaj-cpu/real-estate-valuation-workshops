        "\n",
        "\n",
        "def compose_reply(message: str, history: Optional[list[dict]] = None) -> str:\n",
        "    \"\"\"Three-tier reply: scripted answer, then LLM, then a scripted fallback.\n",
        "\n",
        "    Order matters. The scripted handlers win whenever an intent matches,\n",
        "    because for those topics we already have copy that is faster and has\n",
        "    been checked for legal accuracy -- there is nothing a 1.5B model could\n",
        "    add except the risk of drifting off the verified facts. The model is\n",
        "    reached only for the questions nobody anticipated.\n",
        "    \"\"\"\n",
        "    if not message or not message.strip():\n",
        "        # The UI guards this too, but a blank string is a greeting, not an\n",
        "        # off-topic question -- keep the function correct on its own terms.\n",
        "        return render_welcome()\n",
        "\n",
        "    intent = match_intent(message)\n",
        "    logger.info(\"message=%r -> intent=%s\", message, intent)\n",
        "    if intent:\n",
        "        return RESPONSE_HANDLERS[intent]()\n",
        "\n",
        "    # Tier 2: the language model, if the user has switched it on.\n",
        "    generated = ADVISOR_LLM.answer(message, history)\n",
        "    if generated:\n",
        "        return generated\n",
        "\n",
        "    # Tier 3: typo rescue, then an honest scope statement.\n",
        "    hint = suggest_close_match(message)\n",
        "    if hint:\n",
        "        return (\n",
        "            f\"I could not match that exactly — did you mean something \"\n",
        "            f\"about **{hint}**? Here is what I can cover:\\n\\n\" + render_welcome()\n",
        "        )\n",
        "\n",
        "    if ADVISOR_LLM.status == \"not_loaded\":\n",
        "        offer = (\"\\n\\nFor open questions beyond these topics, switch on the \"\n",
        "                 \"local language model with the button above.\")\n",
        "    elif ADVISOR_LLM.status == \"unavailable\":\n",
        "        # Pointing at a button that already failed would just waste their time.\n",
        "        offer = (\"\\n\\n*(The open-question model could not be loaded, so I am \"\n",
        "                 \"answering from the scripted topics only.)*\")\n",
        "    else:\n",
        "        offer = \"\"\n",
        "    return (\n",
        "        \"That one is outside the topics I have prepared. This desk covers \"\n",
        "        \"the Green Garuda title — its specification, how it compares to \"\n",
        "        \"the red, black and blue titles, boundary and squatter risk, \"\n",
        "        \"selling, mortgaging, survey basis, and the Chanote upgrade.\"\n",
        "        + offer\n",
        "    )"

        "def build_theme() -> gr.themes.Soft:\n",
        "    \"\"\"Palette locked against system dark mode.\n",
        "\n",
        "    Gradio switches to a dark palette when the visitor's OS prefers dark\n",
        "    mode, and the Chatbot panel, inputs and buttons read their colours from\n",
        "    theme CSS variables (each with a \"_dark\" counterpart) rather than from\n",
        "    page-level CSS. Setting every \"_dark\" variant to the same value as its\n",
        "    light counterpart is what stops the chat panel rendering as an unreadable\n",
        "    black box for dark-mode visitors. Values come from TOKENS so the theme\n",
        "    and the stylesheet can never disagree.\n",
        "    \"\"\"\n",
        "    t = TOKENS\n",
        "    pairs = {\n",
        "        \"body_background_fill\": t[\"parchment\"],\n",
        "        \"background_fill_primary\": t[\"parchment\"],\n",
        "        \"background_fill_secondary\": t[\"parchment-deep\"],\n",
        "        \"block_background_fill\": t[\"parchment-deep\"],\n",
        "        \"border_color_primary\": rgba(\"ink\", 0.16),\n",
        "        \"body_text_color\": t[\"ink\"],\n",
        "        \"body_text_color_subdued\": t[\"ink-muted\"],\n",
        "        \"input_background_fill\": t[\"white\"],\n",
        "        \"button_secondary_background_fill\": t[\"parchment-deep\"],\n",
        "        \"button_secondary_background_fill_hover\": t[\"parchment-hover\"],\n",
        "        \"button_secondary_text_color\": t[\"jade-deep\"],\n",
        "        \"button_secondary_border_color\": rgba(\"jade\", 0.35),\n",
        "    }\n",
        "    # Mirror every value onto its *_dark twin instead of listing 24 kwargs.\n",
        "    settings = {}\n",
        "    for name, value in pairs.items():\n",
        "        settings[name] = value\n",
        "        settings[f\"{name}_dark\"] = value\n",
        "    return gr.themes.Soft(primary_hue=\"emerald\", neutral_hue=\"stone\").set(**settings)"

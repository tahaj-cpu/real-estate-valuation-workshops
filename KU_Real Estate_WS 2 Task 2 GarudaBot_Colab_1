    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "YKS2Cccq-XPl"
      },
      "outputs": [],
      "source": [
        "# One dictionary is the single source of truth for every color in the app.\n",
        "# The stylesheet's :root block AND the Gradio theme are both generated from\n",
        "# it, so a brand color can never drift out of sync between the two (the\n",
        "# previous version had the jade accent hard-coded twice, once as a hex and\n",
        "# once as an rgba() border, which is exactly the drift this prevents).\n",
        "\n",
        "TOKENS: dict[str, str] = {\n",
        "    \"parchment\": \"#F7F2E7\",       # page background\n",
        "    \"parchment-deep\": \"#EFE7D6\",  # cards, panels, resting buttons\n",
        "    \"parchment-hover\": \"#FBF7EC\",  # button hover\n",
        "    \"ink\": \"#241F1A\",             # body text            14.63:1 on parchment\n",
        "    \"ink-muted\": \"#655F58\",       # captions, footer       5.65:1 on parchment\n",
        "    \"jade\": \"#1F6B4E\",            # primary accent        5.75:1 on parchment\n",
        "    \"jade-deep\": \"#123D2C\",       # letterhead, headings  9.87:1 on parchment-deep\n",
        "    \"gold\": \"#D2A03C\",            # eyebrow on jade-deep  5.11:1\n",
        "    \"lacquer\": \"#9C3B2E\",         # risk/warning          6.17:1 on lacquer-bg\n",
        "    \"lacquer-bg\": \"#FDF1EE\",\n",
        "    \"note-bg\": \"#ECFDF5\",\n",
        "    \"white\": \"#FFFFFF\",\n",
        "}\n",
        "\n",
        "# Documented so the numbers above can be re-checked rather than trusted.\n",
        "# Recomputed by verify_contrast() in the self-test block at the bottom.\n",
        "CONTRAST_AUDIT: list[tuple[str, str, str, float]] = [\n",
        "    (\"body text\",        \"ink\",       \"parchment\",      4.5),\n",
        "    (\"muted / footer\",   \"ink-muted\", \"parchment\",      4.5),\n",
        "    (\"eyebrow label\",    \"gold\",      \"jade-deep\",      4.5),\n",
        "    (\"button label\",     \"jade-deep\", \"parchment-deep\", 4.5),\n",
        "    (\"risk text\",        \"lacquer\",   \"lacquer-bg\",     4.5),\n",
        "    (\"letterhead title\", \"parchment\", \"jade-deep\",      4.5),\n",
        "]\n",
        "\n",
        "\n",
        "def _hex_to_rgb(value: str) -> tuple[int, int, int]:\n",
        "    value = value.lstrip(\"#\")\n",
        "    return tuple(int(value[i:i + 2], 16) for i in (0, 2, 4))  # type: ignore[return-value]\n",
        "\n",
        "\n",
        "def rgba(token: str, alpha: float) -> str:\n",
        "    \"\"\"Build an rgba() string from a token, so translucent variants stay\n",
        "    derived from the same source color instead of being retyped by hand.\"\"\"\n",
        "    r, g, b = _hex_to_rgb(TOKENS[token])\n",
        "    return f\"rgba({r}, {g}, {b}, {alpha})\"\n",
        "\n",
        "\n",
        "def _relative_luminance(value: str) -> float:\n",
        "    def channel(c: int) -> float:\n",
        "        s = c / 255\n",
        "        return s / 12.92 if s <= 0.03928 else ((s + 0.055) / 1.055) ** 2.4\n",
        "    r, g, b = (channel(c) for c in _hex_to_rgb(value))\n",
        "    return 0.2126 * r + 0.7152 * g + 0.0722 * b\n",
        "\n",
        "\n",
        "def contrast_ratio(token_a: str, token_b: str) -> float:\n",
        "    \"\"\"WCAG 2.1 contrast ratio between two palette tokens.\"\"\"\n",
        "    la, lb = _relative_luminance(TOKENS[token_a]), _relative_luminance(TOKENS[token_b])\n",
        "    hi, lo = max(la, lb), min(la, lb)\n",
        "    return (hi + 0.05) / (lo + 0.05)"
      ],

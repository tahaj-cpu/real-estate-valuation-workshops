    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "LIgoEAro-XPm"
      },
      "outputs": [],
      "source": [
        "\n",
        "CSV_FILENAME = \"garuda_land_titles.csv\"\n",
        "# Written to the notebook's working directory so it shows up in Colab's file\n",
        "# browser and can be downloaded straight from there.\n",
        "CSV_PATH = Path.cwd() / CSV_FILENAME\n",
        "\n",
        "# Internal presentation-only fields; not part of the exported dataset.\n",
        "_NON_DATA_FIELDS = {\"swatch\"}\n",
        "\n",
        "\n",
        "def _data_field_names() -> list[str]:\n",
        "    return [f.name for f in fields(GarudaTitle) if f.name not in _NON_DATA_FIELDS]\n",
        "\n",
        "\n",
        "def export_titles_to_csv(path: Path = CSV_PATH) -> Path:\n",
        "    \"\"\"Task 2.2 (a): persist the title dataset as CSV.\n",
        "\n",
        "    Uses utf-8-sig rather than plain utf-8 so that the Thai column opens\n",
        "    correctly when the file is double-clicked in Excel on Windows, which\n",
        "    assumes the local ANSI codepage unless a BOM is present.\n",
        "    \"\"\"\n",
        "    columns = _data_field_names()\n",
        "    with open(path, \"w\", newline=\"\", encoding=\"utf-8-sig\") as handle:\n",
        "        writer = csv.DictWriter(handle, fieldnames=columns)\n",
        "        writer.writeheader()\n",
        "        for title in TITLES.values():\n",
        "            writer.writerow({c: getattr(title, c) for c in columns})\n",
        "    logger.info(\"Wrote %d rows x %d columns to %s\", len(TITLES), len(columns), path)\n",
        "    return path\n",
        "\n",
        "\n",
        "def display_width(text: str) -> int:\n",
        "    \"\"\"Columns a string occupies in a monospace terminal.\n",
        "\n",
        "    len() is wrong for this dataset. Thai vowel signs and tone marks\n",
        "    (U+0E34-U+0E3A, U+0E47-U+0E4E) are nonspacing marks: they stack on the\n",
        "    preceding consonant and take no column of their own, so padding by len()\n",
        "    pushes every Thai cell too far right and visibly breaks the table.\n",
        "    Note that unicodedata.combining() does NOT catch them -- most Thai marks\n",
        "    have combining class 0 -- so the category test is the reliable one.\n",
        "    Wide CJK characters are counted double for the opposite reason.\n",
        "    \"\"\"\n",
        "    width = 0\n",
        "    for char in text:\n",
        "        if unicodedata.category(char) in (\"Mn\", \"Me\", \"Cf\"):\n",
        "            continue\n",
        "        width += 2 if unicodedata.east_asian_width(char) in (\"W\", \"F\") else 1\n",
        "    return width\n",
        "\n",
        "\n",
        "def _pad(text: str, width: int) -> str:\n",
        "    return text + \" \" * max(0, width - display_width(text))\n",
        "\n",
        "\n",
        "def print_titles_table(focus_key: str = \"green\") -> None:\n",
        "    \"\"\"Task 2.2 (b): print the dataset on the terminal.\n",
        "\n",
        "    Hand-rolled column padding keeps the dependency list at zero (no pandas\n",
        "    or tabulate needed just to satisfy a print statement).\n",
        "    \"\"\"\n",
        "    order = [\"red\", \"green\", \"black\", \"blue\"]\n",
        "    headers = [TITLES[k].color_name + (\" *\" if k == focus_key else \"\") for k in order]\n",
        "\n",
        "    rows = [\n",
        "        [label] + [str(getattr(TITLES[k], field)) for k in order]\n",
        "        for field, label in SPEC_FIELDS\n",
        "    ]\n",
        "    all_rows = [[\"Attribute\"] + headers] + rows\n",
        "    widths = [\n",
        "        max(display_width(str(row[i])) for row in all_rows)\n",
        "        for i in range(len(order) + 1)\n",
        "    ]\n",
        "\n",
        "    def line(char: str = \"-\") -> str:\n",
        "        return \"+\".join(char * (w + 2) for w in widths)\n",
        "\n",
        "    def render(cells: list[str]) -> str:\n",
        "        return \"|\".join(f\" {_pad(str(c), widths[i])} \" for i, c in enumerate(cells))\n",
        "\n",
        "    print()\n",
        "    print(\"THAI LAND TITLE DEEDS -- Workshop 2 dataset\")\n",
        "    print(f\"(* = this group's assigned title: {TITLES[focus_key].display_name})\")\n",
        "    print(line(\"=\"))\n",
        "    print(render([\"Attribute\"] + headers))\n",
        "    print(line(\"=\"))\n",
        "    for row in rows:\n",
        "        print(render(row))\n",
        "    print(line())\n",
        "    print(f\"\\nSaved to: {CSV_PATH}\")\n",
        "    print(f\"Rows: {len(TITLES)}   Columns: {len(_data_field_names())}\\n\")"
      ],
      "id": "LIgoEAro-XPm"

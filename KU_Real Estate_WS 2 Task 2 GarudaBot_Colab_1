        "\n",
        "INTENTS: list[tuple[str, list[str]]] = [\n",
        "    (\"emblem\", [\"picture\", \"image\", \"photo\", \"look like\", \"emblem\", \"logo\"]),\n",
        "    (\"summary\", [\"summary\", \"specification\", \"specs\", \"overview\", \"details\", \"sheet\"]),\n",
        "    (\"compare\", [\"compare\", \"comparison\", \"difference\", \"differences\", \"versus\", \"vs\",\n",
        "                 \"other titles\", \"four\", \"red\", \"black\", \"blue\"]),\n",
        "    (\"upgrade\", [\"upgrade\", \"chanote\", \"convert\", \"conversion\"]),\n",
        "    (\"risk\", [\"squat\", \"squatter\", \"adverse\", \"risk\", \"dispute\", \"disputes\", \"boundary\"]),\n",
        "    (\"sell\", [\"sell\", \"sale\", \"transfer\", \"resell\"]),\n",
        "    (\"mortgage\", [\"mortgage\", \"bank\", \"loan\", \"collateral\", \"finance\"]),\n",
        "    (\"survey\", [\"survey\", \"surveyed\", \"map\", \"mapping\", \"aerial\"]),\n",
        "]\n",
        "\n",
        "_ALL_KEYWORDS = sorted({kw for _, kws in INTENTS for kw in kws})\n",
        "\n",
        "\n",
        "def match_intent(message: str) -> Optional[str]:\n",
        "    \"\"\"Best-matching intent, scored by keyword hits.\n",
        "\n",
        "    Word-boundary regex avoids substring false positives (e.g. 'map' inside\n",
        "    'mapping' counting twice, or 'all' inside 'small'). When a message\n",
        "    touches several topics the highest hit count wins.\n",
        "    \"\"\"\n",
        "    msg = message.lower()\n",
        "    scores: dict[str, int] = {}\n",
        "    for intent, keywords in INTENTS:\n",
        "        hits = sum(1 for kw in keywords if re.search(rf\"\\b{re.escape(kw)}\\b\", msg))\n",
        "        if hits:\n",
        "            scores[intent] = hits\n",
        "    return max(scores, key=lambda k: scores[k]) if scores else None\n",
        "\n",
        "\n",
        "def suggest_close_match(message: str) -> Optional[str]:\n",
        "    \"\"\"Fuzzy fallback for typos, e.g. 'mortgege' -> 'mortgage'.\"\"\"\n",
        "    for word in re.findall(r\"\\w+\", message.lower()):\n",
        "        if len(word) < 4:\n",
        "            continue  # short words produce noisy matches\n",
        "        hit = difflib.get_close_matches(word, _ALL_KEYWORDS, n=1, cutoff=0.8)\n",
        "        if hit:\n",
        "            return hit[0]\n",
        "    return None"
      ],
      "id": "Ehf0suPX-XPo"

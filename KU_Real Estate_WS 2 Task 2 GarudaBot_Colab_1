        "\n",
        "def _model_dtype_kwarg() -> dict:\n",
        "    \"\"\"Pick the right dtype keyword for the installed transformers version.\n",
        "\n",
        "    transformers v5 renamed `torch_dtype` to `dtype` and warns on the old\n",
        "    name; transformers v4 does not accept the new one. Colab's pinned\n",
        "    version changes over time, so this is resolved at runtime instead of\n",
        "    hard-coding whichever happens to be current today.\n",
        "    \"\"\"\n",
        "    try:\n",
        "        import transformers\n",
        "        major = int(transformers.__version__.split(\".\")[0])\n",
        "    except Exception:\n",
        "        major = 4\n",
        "    return {\"dtype\": \"auto\"} if major >= 5 else {\"torch_dtype\": \"auto\"}\n",
        "\n",
        "\n",
        "class LocalAdvisorLLM:\n",
        "    \"\"\"Lazily-loaded local chat model, with honest failure states.\n",
        "\n",
        "    Loading is deliberately NOT done at import. The weights are roughly 3 GB;\n",
        "    downloading them on every kernel start would make the interface take\n",
        "    minutes to appear, and most demo questions never need the model at all.\n",
        "    The user presses the load button once, if and when they want it.\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, model_id: str = LLM_MODEL_ID) -> None:\n",
        "        self.model_id = model_id\n",
        "        self.status = \"not_loaded\"   # not_loaded | loading | ready | unavailable\n",
        "        self.detail = \"\"\n",
        "        self.device = \"cpu\"\n",
        "        self._tokenizer = None\n",
        "        self._model = None\n",
        "\n",
        "    @property\n",
        "    def is_ready(self) -> bool:\n",
        "        return self.status == \"ready\"\n",
        "\n",
        "    def load(self) -> str:\n",
        "        \"\"\"Download and initialise the model. Returns a human-readable status.\"\"\"\n",
        "        if self.status == \"ready\":\n",
        "            return self.detail\n",
        "        self.status = \"loading\"\n",
        "        try:\n",
        "            from transformers import AutoModelForCausalLM, AutoTokenizer\n",
        "            import torch\n",
        "        except ImportError as exc:\n",
        "            self.status = \"unavailable\"\n",
        "            self.detail = (\n",
        "                \"transformers/torch are not installed. In Colab run: \"\n",
        "                \"pip install -q transformers accelerate torch\"\n",
        "            )\n",
        "            logger.warning(\"LLM unavailable: %s\", exc)\n",
        "            return self.detail\n",
        "\n",
        "        try:\n",
        "            logger.info(\"Loading %s (first run downloads ~3 GB)...\", self.model_id)\n",
        "            self._tokenizer = AutoTokenizer.from_pretrained(self.model_id)\n",
        "            self._model = AutoModelForCausalLM.from_pretrained(\n",
        "                self.model_id, **_model_dtype_kwarg()\n",
        "            )\n",
        "            self.device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "            self._model.to(self.device)\n",
        "            self._model.eval()\n",
        "            self.status = \"ready\"\n",
        "            speed = (\"GPU detected: answers in a few seconds.\"\n",
        "                     if self.device == \"cuda\"\n",
        "                     else \"Running on CPU: expect roughly 15-40 seconds per answer. \"\n",
        "                          \"In Colab, Runtime > Change runtime type > T4 GPU is much faster.\")\n",
        "            self.detail = f\"Model ready ({self.model_id}). {speed}\"\n",
        "        except Exception as exc:                      # noqa: BLE001\n",
        "            # Network blocked, out of RAM, gated repo -- all land here, and\n",
        "            # all should degrade to the scripted-only experience rather than\n",
        "            # taking the whole app down.\n",
        "            self.status = \"unavailable\"\n",
        "            self.detail = (\n",
        "                f\"Could not load {self.model_id}: {type(exc).__name__}. \"\n",
        "                \"The scripted topics all still work.\"\n",
        "            )\n",
        "            logger.warning(\"LLM load failed: %s\", exc)\n",
        "        return self.detail\n",
        "\n",
        "    def build_messages(self, question: str,\n",
        "                       history: Optional[list[dict]] = None) -> list[dict]:\n",
        "        \"\"\"Assemble the chat payload: system prompt, recent turns, question.\n",
        "\n",
        "        Only the last few turns are carried over. A 1.5B model has a modest\n",
        "        context window, and the grounding block already consumes a good part\n",
        "        of it -- letting an unbounded transcript push the verified data out\n",
        "        of context is exactly how grounding silently stops working.\n",
        "        \"\"\"\n",
        "        messages = [{\"role\": \"system\", \"content\": LLM_SYSTEM_PROMPT}]\n",
        "        for turn in (history or [])[-4:]:\n",
        "            role = turn.get(\"role\")\n",
        "            content = turn.get(\"content\")\n",
        "            if role in (\"user\", \"assistant\") and isinstance(content, str):\n",
        "                # Strip HTML from scripted answers; markup wastes context and\n",
        "                # teaches the model to imitate our <div> wrappers.\n",
        "                clean = re.sub(r\"<[^>]+>\", \" \", content)\n",
        "                clean = re.sub(r\"\\s+\", \" \", clean).strip()\n",
        "                messages.append({\"role\": role, \"content\": clean[:600]})\n",
        "        messages.append({\"role\": \"user\", \"content\": question})\n",
        "        return messages\n",
        "\n",
        "    def answer(self, question: str,\n",
        "               history: Optional[list[dict]] = None) -> Optional[str]:\n",
        "        \"\"\"Generate a grounded reply, or None if the model can't serve it.\"\"\"\n",
        "        if not self.is_ready:\n",
        "            return None\n",
        "        try:\n",
        "            import torch\n",
        "            messages = self.build_messages(question, history)\n",
        "            prompt = self._tokenizer.apply_chat_template(\n",
        "                messages, tokenize=False, add_generation_prompt=True\n",
        "            )\n",
        "            inputs = self._tokenizer([prompt], return_tensors=\"pt\").to(self.device)\n",
        "            with torch.no_grad():\n",
        "                generated = self._model.generate(\n",
        "                    **inputs,\n",
        "                    max_new_tokens=LLM_MAX_NEW_TOKENS,\n",
        "                    do_sample=True,\n",
        "                    temperature=0.6,      # low: this is advisory copy, not fiction\n",
        "                    top_p=0.9,\n",
        "                    repetition_penalty=1.1,\n",
        "                    pad_token_id=self._tokenizer.eos_token_id,\n",
        "                )\n",
        "            # Keep only the newly generated continuation, not the prompt echo.\n",
        "            new_tokens = generated[0][inputs[\"input_ids\"].shape[-1]:]\n",
        "            text = self._tokenizer.decode(new_tokens, skip_special_tokens=True).strip()\n",
        "            if len(text) < 15:\n",
        "                return None               # empty/degenerate output -> use fallback\n",
        "            return text + \"\\n\\n*Generated by the local assistant from the verified table above. Confirm anything decision-critical with the Land Office.*\"\n",
